+double Editor::KexNowMs() {
+	return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// where a caret is now, gliding from "from" to "to" with an ease-out curve
+KexCaretTarget Editor::KexCurrent(const KexCaret &c, double now) const {
+	if (kexGlideMs <= 0)
+		return c.to;
+	double g = (now - c.start) / kexGlideMs;
+	if (kexFreeze >= 0 && g > kexFreeze)
+		g = kexFreeze;
+	if (g >= 1.0)
+		return c.to;
+	if (g < 0)
+		g = 0;
+	const double e = 1.0 - (1.0 - g) * (1.0 - g) * (1.0 - g);
+	KexCaretTarget t = c.to;
+	t.x = static_cast<XYPOSITION>(c.from.x + (c.to.x - c.from.x) * e);
+	t.y = static_cast<XYPOSITION>(c.from.y + (c.to.y - c.from.y) * e);
+	t.w = static_cast<XYPOSITION>(c.from.w + (c.to.w - c.from.w) * e);
+	t.h = static_cast<XYPOSITION>(c.from.h + (c.to.h - c.from.h) * e);
+	return t;
+}
+
+// The caret's opacity: on for a period, off for a period, with short fades between (or none). Sets
+// nextChangeMs to when that changes next (0: it is fading, -1: never).
+float Editor::KexBlinkAlpha(double now, double *nextChangeMs) const {
+	*nextChangeMs = -1;
+	const double P = caret.period;
+	if (kexSolid || P <= 0)
+		return 1.0f;
+	const double F = kexFade ? std::min(140.0, P / 3) : 0.0;
+	const double ph = std::fmod(now - kexBlinkStart, 2 * P);
+	if (ph < P - F) {
+		*nextChangeMs = (P - F) - ph;
+		return 1.0f;
+	}
+	if (ph < P) {
+		*nextChangeMs = 0;
+		return static_cast<float>(1.0 - (ph - (P - F)) / F);
+	}
+	if (ph < 2 * P - F) {
+		*nextChangeMs = (2 * P - F) - ph;
+		return 0.0f;
+	}
+	*nextChangeMs = 0;
+	return F > 0 ? static_cast<float>((ph - (2 * P - F)) / F) : 1.0f;
