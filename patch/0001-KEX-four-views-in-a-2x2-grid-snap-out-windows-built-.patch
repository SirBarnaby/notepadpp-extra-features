+//
+// Grid layout
+//
+
+Window* Notepad_plus::kexEditorAreaWindow()
+{
+	bool docked[NB_VIEWS]{};
+	for (int v = 0; v < NB_VIEWS; ++v)
+		docked[v] = viewVisible(v) && !kexIsTornOut(v);
+
+	// each column is its top view, its bottom view, or both in a column splitter
+	Window* column[2] = {};
+	for (int col = 0; col < 2; ++col)
+	{
+		DocTabView* top = kexDocTab(col);              // main / sub
+		DocTabView* bottom = kexDocTab(col + VIEW_3);  // view 3 / view 4
+		if (docked[col] && docked[col + VIEW_3])
+		{
+			SplitterContainer& splitter = _kexColumnSplitter[col];
+			const bool swapped = (splitter.getWin0() == bottom); // the user rotated it
+			splitter.setWin0(swapped ? bottom : top);
+			splitter.setWin1(swapped ? top : bottom);
+			column[col] = &splitter;
+		}
+		else if (docked[col])
+			column[col] = top;
+		else if (docked[col + VIEW_3])
+			column[col] = bottom;
+	}
+
+	if (column[0] && column[1])
+	{
+		Window* first = _subSplitter.getWin0();
+		const bool swapped = (first == &_kexColumnSplitter[1] || first == &_subDocTab || first == &_view4DocTab);
+		_subSplitter.setWin0(swapped ? column[1] : column[0]);
+		_subSplitter.setWin1(swapped ? column[0] : column[1]);
+		return &_subSplitter;
+	}
+	if (column[0])
+		return column[0];
+	if (column[1])
+		return column[1];
+	return &_mainDocTab;
+}
+
+void Notepad_plus::kexLayoutViews()
+{
+	if (!_kexColumnSplitterCreated)
+		return;
+
+	// the main window always keeps at least one view
+	if (kexNbVisibleViews() == 0)
+		_mainWindowStatus |= WindowMainActive;
+	if (kexNbDockedViews() == 0)
+	{
+		for (int v = 0; v < NB_VIEWS; ++v)
+		{
+			if (viewVisible(v) && kexIsTornOut(v))
+			{
+				kexSnapBackView(v, false);
+				break;
+			}
+		}
+	}
+
+	Window* area = kexEditorAreaWindow();
+
+	bool columnUsed[2]{};
+	for (int col = 0; col < 2; ++col)
+	{
+		Window* pCol = &_kexColumnSplitter[col];
+		columnUsed[col] = (area == pCol) || (area == &_subSplitter && (_subSplitter.getWin0() == pCol || _subSplitter.getWin1() == pCol));
+	}
+	const bool rowUsed = (area == &_subSplitter);
+
+	// show the views that are visible (docked or torn out), hide the others
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		const bool show = viewVisible(v);
+		kexEditView(v)->display(show);
+		kexDocTab(v)->display(show);
+	}
+
+	// hide unused splitters with ShowWindow only: display(false) would also hide the views inside them
+	for (int col = 0; col < 2; ++col)
+	{
+		if (columnUsed[col])
+			_kexColumnSplitter[col].display(true);
+		else
+			::ShowWindow(_kexColumnSplitter[col].getHSelf(), SW_HIDE);
+	}
+	if (rowUsed)
+		_subSplitter.display(true);
+	else
+		::ShowWindow(_subSplitter.getHSelf(), SW_HIDE);
+
+	if ((_mainWindowStatus & WindowUserActive) && _pMainSplitter)
+	{
+		// the docked user-defined-language panel sits to the right of the grid
+		_pMainSplitter->setWin0(area);
+		if (!::IsWindowVisible(_pMainSplitter->getHSelf()))
+			_pMainSplitter->display(true);
+		else
+			area->display(true);
+		_pMainWindow = _pMainSplitter;
+	}
+	else
+	{
+		if (_pMainSplitter)
+			::ShowWindow(_pMainSplitter->getHSelf(), SW_HIDE);
+		area->display(true);
+		_pMainWindow = area;
+	}
+
+	// torn-out windows follow their view's visibility
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		HWND frame = _kexViewWindow[v];
+		if (!frame)
+			continue;
+		if (viewVisible(v))
+		{
+			if (!::IsWindowVisible(frame))
+				::ShowWindow(frame, SW_SHOWNOACTIVATE);
+			kexLayoutTornOutView(v);
+		}
+		else
+		{
+			::ShowWindow(frame, SW_HIDE);
+		}
+	}
+
+	::SendMessage(_pPublicInterface->getHSelf(), WM_SIZE, 0, 0);
+}
+
+void Notepad_plus::kexOnSplitterRotated(HWND hSplitter, int direction)
+{
+	if (hSplitter == _subSplitter.getHSelf())
+	{
+		// keep the grid a grid: the column splitters turn the same way, so the whole 2x2 grid rotates
+		const int cmd = (direction == static_cast<int>(DIRECTION::LEFT)) ? KEX_ROTATION_LEFT : KEX_ROTATION_RIGHT;
+		for (int col = 0; col < 2; ++col)
+			::SendMessage(_kexColumnSplitter[col].getHSelf(), WM_COMMAND, cmd, 0);
+	}
+	kexLayoutViews();
+}
+
+
+//
+// Torn-out views
+//
+
+void Notepad_plus::kexLayoutTornOutView(int whichOne)
+{
+	HWND frame = (whichOne >= 0 && whichOne < NB_VIEWS) ? _kexViewWindow[whichOne] : nullptr;
+	if (!frame || ::IsIconic(frame))
+		return;
+
+	RECT rc{};
+	::GetClientRect(frame, &rc); // {0, 0, width, height} is also the {x, y, w, h} that reSizeTo expects
+	if (rc.right <= 0 || rc.bottom <= 0)
+		return;
+	kexDocTab(whichOne)->reSizeTo(rc);
+}
+
+void Notepad_plus::kexUpdateTornOutTitle(int whichOne)
+{
+	HWND frame = _kexViewWindow[whichOne];
+	if (!frame)
+		return;
+
+	wstring title;
+	Buffer* buf = kexEditView(whichOne)->getCurrentBuffer();
+	if (buf)
+	{
+		if (buf->isDirty())
+			title += L"*";
+		title += buf->getFileName();
+		title += L" - ";
+	}
+	title += Notepad_plus_Window::getAppName();
+
+	wchar_t current[1024]{};
+	::GetWindowText(frame, current, _countof(current));
+	if (title != current)
+		::SetWindowText(frame, title.c_str());
+}
+
+void Notepad_plus::kexUpdateTornOutTitles()
+{
+	for (int v = 0; v < NB_VIEWS; ++v)
+		kexUpdateTornOutTitle(v);
+}
+
+bool Notepad_plus::kexIsOverDockedTabBar(POINT screenPoint)
+{
+	HWND hNpp = _pPublicInterface->getHSelf();
+	if (!::IsWindowVisible(hNpp) || ::IsIconic(hNpp))
+		return false;
+
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		if (!viewVisible(v) || kexIsTornOut(v))
+			continue;
+		RECT rcTab{}, rcEdit{};
+		::GetWindowRect(kexDocTab(v)->getHSelf(), &rcTab);
+		::GetWindowRect(kexEditView(v)->getHSelf(), &rcEdit);
+		// the tab control spans the whole pane, the edit view covers all of it but the tab strip
+		if (::PtInRect(&rcTab, screenPoint) && !::PtInRect(&rcEdit, screenPoint))
+			return true;
+	}
+	return false;
+}
+
+bool Notepad_plus::kexTearOutView(int whichOne, const POINT* where, const RECT* windowRect)
+{
+	if (whichOne < 0 || whichOne >= NB_VIEWS)
+		return false;
+
+	if (kexIsTornOut(whichOne))
+	{
+		if (::IsWindowVisible(_kexViewWindow[whichOne]))
+			::SetForegroundWindow(_kexViewWindow[whichOne]);
+		return true;
+	}
+
+	// the main window must keep at least one view
+	if (viewVisible(whichOne) && kexNbDockedViews() < 2)
+		return false;
+
+	HWND hNpp = _pPublicInterface->getHSelf();
+	HINSTANCE hInst = _pPublicInterface->getHinst();
+	kexNpp = this;
+
+	static bool isRegistered = false;
+	if (!isRegistered)
+	{
+		WNDCLASSEXW wc{};
+		wc.cbSize = sizeof(wc);
+		wc.style = CS_DBLCLKS;
+		wc.lpfnWndProc = kexViewWindowProc;
+		wc.hInstance = hInst;
+		wc.hCursor = ::LoadCursor(nullptr, IDC_ARROW);
+		wc.hIcon = reinterpret_cast<HICON>(::GetClassLongPtr(hNpp, GCLP_HICON));
+		wc.hIconSm = reinterpret_cast<HICON>(::GetClassLongPtr(hNpp, GCLP_HICONSM));
+		wc.lpszClassName = KEX_VIEW_WINDOW_CLASS;
+		isRegistered = (::RegisterClassExW(&wc) != 0) || (::GetLastError() == ERROR_CLASS_ALREADY_EXISTS);
+		if (!isRegistered)
+			return false;
+	}
+
+	// default size: the view's current size (or the current view's), at the cursor or offset from Notepad++
+	DocTabView* pSizeRef = viewVisible(whichOne) ? kexDocTab(whichOne) : _pDocTab;
+	RECT rcRef{};
+	::GetWindowRect(pSizeRef->getHSelf(), &rcRef);
+	RECT rcFrame{ 0, 0, std::max<LONG>(rcRef.right - rcRef.left, 480), std::max<LONG>(rcRef.bottom - rcRef.top, 320) };
+	::AdjustWindowRectEx(&rcFrame, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW);
+	const int width = rcFrame.right - rcFrame.left;
+	const int height = rcFrame.bottom - rcFrame.top;
+	POINT pos{ rcRef.left + 40, rcRef.top + 40 };
+	if (where)
+	{
+		pos.x = where->x - width / 2;
+		pos.y = where->y - ::GetSystemMetrics(SM_CYCAPTION) / 2;
+	}
+	MONITORINFO mi{};
+	mi.cbSize = sizeof(mi);
+	if (::GetMonitorInfo(::MonitorFromPoint(pos, MONITOR_DEFAULTTONEAREST), &mi))
+	{
+		pos.x = std::max(mi.rcWork.left, std::min(pos.x, mi.rcWork.right - width));
+		pos.y = std::max(mi.rcWork.top, std::min(pos.y, mi.rcWork.bottom - height));
+	}
+
+	HWND frame = ::CreateWindowExW(WS_EX_APPWINDOW | WS_EX_ACCEPTFILES, KEX_VIEW_WINDOW_CLASS, L"Notepad++",
+		WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN, pos.x, pos.y, width, height, nullptr, nullptr, hInst, nullptr);
+	if (!frame)
+		return false;
+	::SetWindowLongPtr(frame, GWLP_USERDATA, static_cast<LONG_PTR>(whichOne));
+
+	if (windowRect && !::IsRectEmpty(windowRect))
+	{
+		// restored from the session: same coordinates GetWindowPlacement gave us; Windows keeps it on screen
+		WINDOWPLACEMENT wp{};
+		wp.length = sizeof(wp);
+		wp.showCmd = SW_HIDE;
+		wp.rcNormalPosition = *windowRect;
+		::SetWindowPlacement(frame, &wp);
+	}
+
+	NppDarkMode::setDarkTitleBar(frame);
+
+	_kexViewWindow[whichOne] = frame;
+	HWND hTab = kexDocTab(whichOne)->getHSelf();
+	HWND hEdit = kexEditView(whichOne)->getHSelf();
+	::SetParent(hTab, frame);
+	::SetParent(hEdit, frame);
+	::SetWindowPos(hEdit, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+
+	kexUpdateTornOutTitle(whichOne); // later on every tab switch, save and rename (setTitle, notifyBufferChanged)
+
+	kexLayoutViews(); // takes the view out of the grid; shows the window if the view is visible
+
+	if (viewVisible(whichOne))
+	{
+		::SetForegroundWindow(frame);
+		switchEditViewTo(whichOne);
+	}
+	return true;
+}
+
+bool Notepad_plus::kexSnapBackView(int whichOne, bool relayout)
+{
+	if (whichOne < 0 || whichOne >= NB_VIEWS || !_kexViewWindow[whichOne])
+		return false;
+
+	HWND frame = _kexViewWindow[whichOne];
+	HWND hNpp = _pPublicInterface->getHSelf();
+	const bool wasActive = (::GetForegroundWindow() == frame);
+
+	_kexViewWindow[whichOne] = nullptr;
+	::SetWindowLongPtr(frame, GWLP_USERDATA, -1);
+
+	HWND hTab = kexDocTab(whichOne)->getHSelf();
+	HWND hEdit = kexEditView(whichOne)->getHSelf();
+	::SetParent(hTab, hNpp);
+	::SetParent(hEdit, hNpp);
+	// back on top of the splitters, with the edit view above its tab control as Notepad++ creates them
+	::SetWindowPos(hEdit, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+	::SetWindowPos(hTab, hEdit, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+
+	if (wasActive)
+		::SetForegroundWindow(hNpp);
+	::DestroyWindow(frame);
+
+	if (relayout)
+	{
+		kexLayoutViews();
+		if (viewVisible(whichOne))
+			switchEditViewTo(whichOne);
+		else
+			_pEditView->grabFocus();
+	}
+	return true;
+}
+
+void Notepad_plus::kexDestroyTornOutWindows()
+{
+	// give the views back to the main window first, so destroying a frame doesn't destroy them
+	for (int v = 0; v < NB_VIEWS; ++v)
+		kexSnapBackView(v, false);
+}
+
+bool Notepad_plus::kexTearOutDoc(FileTransferMode mode, const POINT* where)
+{
+	const int fromView = currentView();
+
+	// the only document of a view: the whole view snaps out (unless it is the last view in the main window)
+	if (_pDocTab->nbItem() == 1 && mode == TransferMove)
+	{
+		if (kexIsTornOut(fromView))
+			return false;
+		return kexTearOutView(fromView, where);
+	}
+
+	// otherwise the document moves to a hidden view, which snaps out
+	static constexpr int order[NB_VIEWS] = { VIEW_4, VIEW_3, SUB_VIEW, MAIN_VIEW };
+	int target = -1;
+	for (int v : order)
+	{
+		if (!viewVisible(v) && !kexIsTornOut(v))
+		{
+			target = v;
+			break;
+		}
+	}
+	if (target == -1)
+		return false; // all four views are in use
+
+	if (!kexTearOutView(target, where))
+		return false;
+
+	docGotoAnotherEditView(mode, target);
+	checkSyncState();
+
+	if (!viewVisible(target))
+	{
+		// the transfer didn't happen: put the empty view back
+		kexSnapBackView(target);
+		return false;
+	}
+
+	::SetForegroundWindow(_kexViewWindow[target]);
+	switchEditViewTo(target);
+	return true;
+}
+
+LRESULT CALLBACK Notepad_plus::kexViewWindowProc(HWND hwnd, UINT message, WPARAM wParam, LPARAM lParam)
+{
+	const int view = static_cast<int>(::GetWindowLongPtr(hwnd, GWLP_USERDATA));
+	Notepad_plus* self = kexNpp;
+	if (!self || view < 0 || view >= NB_VIEWS || self->_kexViewWindow[view] != hwnd)
+		return ::DefWindowProc(hwnd, message, wParam, lParam);
+
+	HWND hNpp = self->_pPublicInterface->getHSelf();
+
+	switch (message)
+	{
+		case WM_SIZE:
+		{
+			if (wParam != SIZE_MINIMIZED)
+				self->kexLayoutTornOutView(view);
+			return 0;
+		}
+
+		case WM_NOTIFY:
+		case WM_COMMAND:
+		case WM_DROPFILES:
+		{
+			// Scintilla and the tab bar notify their parent, which is now this window
+			return ::SendMessage(hNpp, message, wParam, lParam);
+		}
+
+		case WM_CONTEXTMENU:
+		{
+			if (reinterpret_cast<HWND>(wParam) == hwnd)
+				break; // title bar: the system menu
+			return ::SendMessage(hNpp, message, wParam, lParam);
+		}
+
+		case WM_ACTIVATE:
+		{
+			if (LOWORD(wParam) != WA_INACTIVE && !HIWORD(wParam) && self->viewVisible(view))
+			{
+				self->switchEditViewTo(view);
+				return 0;
+			}
+			break;
+		}
+
+		case WM_SETFOCUS:
+		{
+			self->kexEditView(view)->grabFocus();
+			return 0;
+		}
+
+		case WM_ENTERSIZEMOVE:
+		{
+			kexMovedSinceEnter[view] = false;
+			break;
+		}
+
+		case WM_MOVING:
+		{
+			kexMovedSinceEnter[view] = true;
+			break;
+		}
+
+		case WM_EXITSIZEMOVE:
+		{
+			// dropped onto a tab bar of the main window: snap back in
+			POINT p{};
+			::GetCursorPos(&p);
+			if (kexMovedSinceEnter[view] && self->kexIsOverDockedTabBar(p))
+				::PostMessage(hNpp, NPPM_KEX_TEAROUTVIEW, view, FALSE);
+			kexMovedSinceEnter[view] = false;
+			break;
+		}
+
+		case WM_CLOSE:
+		{
+			// closing the window brings the view home, it never closes documents
+			self->kexSnapBackView(view);
+			return 0;
+		}
+
+		case WM_ERASEBKGND:
+		{
+			RECT rc{};
+			::GetClientRect(hwnd, &rc);
+			HBRUSH hbr = NppDarkMode::isEnabled() ? NppDarkMode::getBackgroundBrush() : ::GetSysColorBrush(COLOR_BTNFACE);
+			::FillRect(reinterpret_cast<HDC>(wParam), &rc, hbr);
+			return TRUE;
+		}
+
+		case WM_GETMINMAXINFO:
+		{
+			auto* mmi = reinterpret_cast<MINMAXINFO*>(lParam);
+			mmi->ptMinTrackSize.x = 200;
+			mmi->ptMinTrackSize.y = 120;
+			return 0;
+		}
+
+		case WM_DPICHANGED:
+		{
+			const RECT* rcNew = reinterpret_cast<const RECT*>(lParam);
+			::SetWindowPos(hwnd, nullptr, rcNew->left, rcNew->top, rcNew->right - rcNew->left, rcNew->bottom - rcNew->top, SWP_NOZORDER | SWP_NOACTIVATE);
+			return 0;
+		}
+
+		default:
+			break;
+	}
+	return ::DefWindowProc(hwnd, message, wParam, lParam);
+}
+
+
+//
+// Tab snapping: drag a tab to the edge of a view to open a new view there, or onto another view
+// to move it there. While the tab moves the suite draws where it would land (kexsuite::tabSnapPreview).
+//
+
+static constexpr double KEX_SNAP_BAND = 0.33; // the outer third of a view, towards a side where a view can open
+
+static RECT kexWindowRect(HWND hwnd)
+{
+	RECT rc{};
+	::GetWindowRect(hwnd, &rc);
+	return rc;
+}
+
+static LONG kexRectArea(const RECT& rc)
+{
+	return (rc.right > rc.left && rc.bottom > rc.top) ? (rc.right - rc.left) * (rc.bottom - rc.top) : 0;
+}
+
+// Splits rc the way a splitter container splits its two panes: its orientation, its current
+// ratio (where its bar sits, even while it is hidden) and the width of its bar.
+static void kexSplitLike(const SplitterContainer& container, const RECT& rc, RECT& first, RECT& second)
+{
+	const bool leftRight = container.isVertical();
+	double ratio = 0.5;
+	int bar = 4;
+	HWND hBar = ::GetWindow(container.getHSelf(), GW_CHILD);
+	RECT rcContainer{};
+	::GetClientRect(container.getHSelf(), &rcContainer);
+	if (hBar)
+	{
+		RECT rcBar = kexWindowRect(hBar);
+		::MapWindowPoints(nullptr, container.getHSelf(), reinterpret_cast<POINT*>(&rcBar), 2);
+		const LONG extent = leftRight ? rcContainer.right : rcContainer.bottom;
+		const LONG thickness = leftRight ? (rcBar.right - rcBar.left) : (rcBar.bottom - rcBar.top);
+		if (extent > 0 && thickness > 0 && thickness < extent)
+		{
+			const double r = ((leftRight ? rcBar.left : rcBar.top) + thickness / 2.0) / extent;
+			if (r > 0.05 && r < 0.95)
+				ratio = r;
+			bar = thickness;
+		}
+	}
+	first = second = rc;
+	if (leftRight)
+	{
+		const LONG x = rc.left + static_cast<LONG>((rc.right - rc.left) * ratio) - bar / 2;
+		first.right = x;
+		second.left = x + bar;
+	}
+	else
+	{
+		const LONG y = rc.top + static_cast<LONG>((rc.bottom - rc.top) * ratio) - bar / 2;
+		first.bottom = y;
+		second.top = y + bar;
+	}
+}
+
+// Where view whichOne would sit inside area if the docked views were dockedViews (bit v = view v),
+// following kexEditorAreaWindow(): a column per pair (main/view 3, sub/view 4), split when both are in.
+RECT Notepad_plus::kexPredictViewRect(int whichOne, unsigned dockedViews, const RECT& area)
+{
+	auto docked = [dockedViews](int v) { return (dockedViews & (1u << v)) != 0; };
+
+	RECT column[2] = { area, area };
+	if ((docked(MAIN_VIEW) || docked(VIEW_3)) && (docked(SUB_VIEW) || docked(VIEW_4)))
+	{
+		RECT first{}, second{};
+		kexSplitLike(_subSplitter, area, first, second);
+		const Window* win0 = _subSplitter.getWin0();
+		const bool swapped = (win0 == &_kexColumnSplitter[1] || win0 == &_subDocTab || win0 == &_view4DocTab);
+		column[0] = swapped ? second : first;
+		column[1] = swapped ? first : second;
+	}
+
+	const int col = whichOne % 2; // main and view 3 share the first column, sub and view 4 the second
+	const int top = col;
+	const int bottom = col + VIEW_3;
+	if (docked(top) && docked(bottom))
+	{
+		RECT first{}, second{};
+		kexSplitLike(_kexColumnSplitter[col], column[col], first, second);
+		const bool swapped = (_kexColumnSplitter[col].getWin0() == kexDocTab(bottom));
+		return ((whichOne == top) != swapped) ? first : second;
+	}
+	return column[col];
+}
+
+Notepad_plus::KexSnapTarget Notepad_plus::kexSnapTargetAt(POINT screenPoint, bool clone)
+{
+	KexSnapTarget none;
+	const int source = currentView();
+	HWND hNpp = _pPublicInterface->getHSelf();
+	HWND hit = kexsuite::windowFromPoint(screenPoint);
+	if (!hit)
+		return none;
+
+	// a torn-out view takes the tab as a whole
+	const int hitView = kexViewFromHwnd(hit);
+	if (hitView != -1 && kexIsTornOut(hitView))
+	{
+		if (hitView == source)
+			return none;
+		KexSnapTarget target;
+		target.view = hitView;
+		::GetClientRect(_kexViewWindow[hitView], &target.preview);
+		::MapWindowPoints(_kexViewWindow[hitView], nullptr, reinterpret_cast<POINT*>(&target.preview), 2);
+		return target;
+	}
+	if (::GetAncestor(hit, GA_ROOT) != hNpp || ::IsIconic(hNpp))
+		return none;
+
+	// the docked views, the area they fill and the one under the pointer
+	unsigned dockedViews = 0;
+	RECT viewRect[NB_VIEWS]{};
+	RECT area{};
+	int over = -1;
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		if (!viewVisible(v) || kexIsTornOut(v))
+			continue;
+		dockedViews |= 1u << v;
+		viewRect[v] = kexWindowRect(kexDocTab(v)->getHSelf()); // the tab control spans the whole pane
+		::UnionRect(&area, &area, &viewRect[v]);
+		if (::PtInRect(&viewRect[v], screenPoint))
+			over = v;
+	}
+	if (over == -1)
+		return none;
+	const RECT& rcOver = viewRect[over];
+	const RECT rcEdit = kexWindowRect(kexEditView(over)->getHSelf());
+	const bool overTabStrip = !::PtInRect(&rcEdit, screenPoint);
+
+	// Near an edge: a hidden view that would open on that side of this view. Notepad++ never
+	// moves the only tab of a view into a hidden view (docGotoAnotherEditView), but it can clone it.
+	const bool canOpenView = !overTabStrip && (clone || kexDocTab(source)->nbItem() > 1);
+	const double w = (std::max)(1L, rcOver.right - rcOver.left);
+	const double h = (std::max)(1L, rcOver.bottom - rcOver.top);
+	KexSnapTarget best;
+	double bestDepth = KEX_SNAP_BAND;
+	bool bestSameRow = false;
+	for (int v = 0; canOpenView && v < NB_VIEWS; ++v)
+	{
+		if (viewVisible(v))
+			continue;
+		const RECT predicted = kexPredictViewRect(v, dockedViews | (1u << v), area);
+		RECT inside{};
+		if (!::IntersectRect(&inside, &predicted, &rcOver) || kexRectArea(inside) * 10 < kexRectArea(predicted) * 3)
+			continue; // it would not open inside the view under the pointer
+
+		// which side of the view it takes, and how far the pointer is from that edge
+		const double dx = ((inside.left + inside.right) - (rcOver.left + rcOver.right)) / 2.0 / w;
+		const double dy = ((inside.top + inside.bottom) - (rcOver.top + rcOver.bottom)) / 2.0 / h;
+		if (std::abs(dx) < 0.05 && std::abs(dy) < 0.05)
+			continue;
+		double depth = 0;
+		if (std::abs(dx) >= std::abs(dy))
+			depth = (dx > 0) ? (rcOver.right - screenPoint.x) / w : (screenPoint.x - rcOver.left) / w;
+		else
+			depth = (dy > 0) ? (rcOver.bottom - screenPoint.y) / h : (screenPoint.y - rcOver.top) / h;
+
+		// two hidden views can open in the same place (e.g. sub and view 4 next to a lone main view):
+		// prefer the one in the same row as the view under the pointer
+		const bool sameRow = ((v >= VIEW_3) == (over >= VIEW_3));
+		if (depth < bestDepth || (depth == bestDepth && sameRow && !bestSameRow))
+		{
+			best.view = v;
+			best.preview = predicted;
+			bestDepth = depth;
+			bestSameRow = sameRow;
+		}
+	}
+	if (best.view != -1)
+		return best;
+
+	// anywhere else on another view: the tab moves into it
+	if (over == source)
+		return none;
+	KexSnapTarget target;
+	target.view = over;
+	target.preview = rcOver;
+	return target;
+}
+
+// A tab was dropped at screenPoint with tab snapping on. False = the drop was outside every
+// Notepad++ window, so the usual handling applies (a window of its own, or another instance).
+bool Notepad_plus::kexSnapDrop(POINT screenPoint, bool clone)
+{
+	kexsuite::tabSnapPreview(nullptr);
+	const KexSnapTarget target = kexSnapTargetAt(screenPoint, clone);
+	if (target.view != -1)
+	{
+		docGotoAnotherEditView(clone ? TransferClone : TransferMove, target.view);
+		checkSyncState();
+		return true;
+	}
+
+	// anywhere else in Notepad++ (its own view, the toolbar...) the drop does nothing, with no menu
+	HWND hit = kexsuite::windowFromPoint(screenPoint);
+	return hit && (::GetAncestor(hit, GA_ROOT) == _pPublicInterface->getHSelf() || kexViewFromHwnd(hit) != -1);
+}
+
+void Notepad_plus::kexOnTabDrag(int state, HWND tabBar)
+{
+	kexsuite::tabDragged(tabBar, state);
+	if (state == KEX_TABDRAG_STARTED)
+		return;
+	if (state == KEX_TABDRAG_MOVED && kexsuite::tabSnapOn())
+	{
+		POINT p{};
+		::GetCursorPos(&p);
+		const bool clone = (::GetKeyState(VK_LCONTROL) & 0x80000000) != 0; // as the drop handler reads it
+		const KexSnapTarget target = kexSnapTargetAt(p, clone);
+		kexsuite::tabSnapPreview(target.view != -1 ? &target.preview : nullptr);
+	}
+	else
+	{
+		kexsuite::tabSnapPreview(nullptr);
+	}
+}
+
+
+//
+// Menus and messages
+//
+
+void Notepad_plus::kexInitMenu()
+{
+	// the new commands go at the end of View > Move/Clone Current Document, so no other submenu moves
+	// (translations address submenus by position)
+	HMENU hSub = nullptr;
+	const int nbTop = ::GetMenuItemCount(_mainMenuHandle);
+	for (int i = 0; i < nbTop && !hSub; ++i)
+	{
+		HMENU hTop = ::GetSubMenu(_mainMenuHandle, i);
+		const int nbItems = hTop ? ::GetMenuItemCount(hTop) : 0;
+		for (int j = 0; j < nbItems && !hSub; ++j)
+		{
+			HMENU hCandidate = ::GetSubMenu(hTop, j);
+			if (hCandidate && ::GetMenuState(hCandidate, IDM_VIEW_GOTO_ANOTHER_VIEW, MF_BYCOMMAND) != static_cast<UINT>(-1))
+				hSub = hCandidate;
+		}
+	}
+	if (!hSub)
+		return;
+
+	struct Item { UINT id; const wchar_t* text; };
+	static constexpr Item items[] = {
+		{ 0, nullptr },
+		{ IDM_KEX_DOC_TO_VIEW1, L"Move to View &1 (Top Left)" },
+		{ IDM_KEX_DOC_TO_VIEW2, L"Move to View &2 (Top Right)" },
+		{ IDM_KEX_DOC_TO_VIEW3, L"Move to View &3 (Bottom Left)" },
+		{ IDM_KEX_DOC_TO_VIEW4, L"Move to View &4 (Bottom Right)" },
+		{ IDM_KEX_DOC_CLONE_TO_VIEW1, L"Clone to View 1" },
+		{ IDM_KEX_DOC_CLONE_TO_VIEW2, L"Clone to View 2" },
+		{ IDM_KEX_DOC_CLONE_TO_VIEW3, L"Clone to View 3" },
+		{ IDM_KEX_DOC_CLONE_TO_VIEW4, L"Clone to View 4" },
+		{ 0, nullptr },
+		{ IDM_KEX_DOC_TEAROUT, L"Move to New &Window" },
+		{ IDM_KEX_VIEW_TEAROUT, L"&Snap This View Out" },
+		{ IDM_KEX_VIEW_SNAPBACK, L"Snap This View &Back In" },
+		{ IDM_KEX_SNAPBACK_ALL, L"Snap &All Views Back In" },
+		{ 0, nullptr },
+		{ IDM_KEX_FOCUS_VIEW1, L"Focus View 1" },
+		{ IDM_KEX_FOCUS_VIEW2, L"Focus View 2" },
+		{ IDM_KEX_FOCUS_VIEW3, L"Focus View 3" },
+		{ IDM_KEX_FOCUS_VIEW4, L"Focus View 4" },
+	};
+	for (const Item& item : items)
+	{
+		if (item.id == 0)
+			::AppendMenu(hSub, MF_SEPARATOR, 0, nullptr);
+		else
+			::AppendMenu(hSub, MF_STRING, item.id, item.text);
+	}
+}
+
+// "A Notepad++ for each desktop" (KEX suite). When notepad++.exe starts on a virtual desktop that has no
+// Notepad++ window, the suite opens a new instance there instead of moving the running one, and the new
+// instance starts with a copy of the running one's tabs: this instance writes them into a folder (a
+// session file, plus a copy of every untitled tab's text), the new one opens them the way Notepad++
+// restores its own backups at startup.
+static const wchar_t kexCopySessionFile[] = L"\\session.xml";
+static const wchar_t kexCopyIndexFile[] = L"\\untitled.txt";   // UTF-8 lines "<copy file>\t<tab name>"
+
+int Notepad_plus::kexSaveDesktopCopy(const wchar_t* folder)
+{
+	if (!folder || !*folder)
+		return -1;
+	const wstring dir = folder;
+	Session session;
+	getCurrentOpenedFiles(session, true);
+
+	wstring index;
+	int nbCopies = 0;
+	for (int view = 0; view < NB_VIEWS; ++view)
+	{
+		DocTabView* docTab = kexDocTab(view);
+		vector<sessionFileInfo>& files = session.kexViewFiles(view);
+		const size_t activeTab = docTab->getCurrentTabIndex();
+		size_t activeEntry = files.size();
+		for (size_t i = 0, e = 0; i < docTab->nbItem() && e < files.size(); ++i)
+		{
+			Buffer* buf = MainFileManager.getBufferByID(docTab->getBufferByIndex(i));
+			if (buf->isUntitled() && buf->docLength() == 0)
+				continue; // getCurrentOpenedFiles leaves these out too
+			if (i == activeTab)
+				activeEntry = e;
+			sessionFileInfo& sfi = files[e++];
+			sfi._backupFilePath.clear(); // the new instance must never use this instance's own backups
+			if (buf->isUntitled() && index.find(L"\t" + sfi._fileName + L"\n") == wstring::npos) // a clone is copied once
+			{
+				const wstring copyName = L"untitled-" + std::to_wstring(++nbCopies) + L".txt";
+				if (MainFileManager.saveBuffer(buf, (dir + L"\\" + copyName).c_str(), true) == SavingStatus::SaveOK)
+					index += copyName + L"\t" + sfi._fileName + L"\n";
+			}
+		}
+		session.kexActiveIndex(view) = activeEntry; // an index into the saved entries, not into the tabs
+	}
+
+	FILE* f = nullptr;
+	if (_wfopen_s(&f, (dir + kexCopyIndexFile).c_str(), L"wb") != 0 || !f)
+		return -1;
+	const string utf8 = wstring2string(index, CP_UTF8);
+	fwrite(utf8.data(), 1, utf8.size(), f);
+	fclose(f);
+
+	NppParameters::getInstance().writeSession(session, (dir + kexCopySessionFile).c_str());
+	if (!doesFileExist((dir + kexCopySessionFile).c_str()))
+		return -1;
+	return static_cast<int>(session.kexNbFiles());
+}
+
+int Notepad_plus::kexLoadDesktopCopy(const wchar_t* folder)
+{
+	if (!folder || !*folder)
+		return -1;
+	const wstring dir = folder;
+	NppParameters& nppParam = NppParameters::getInstance();
+	Session session;
+	if (!nppParam.loadSession(session, (dir + kexCopySessionFile).c_str(), true))
+		return -1;
+
+	// untitled tabs come back from their copies
+	std::vector<std::pair<wstring, wstring>> copies; // tab name, copy path
+	FILE* f = nullptr;
+	if (_wfopen_s(&f, (dir + kexCopyIndexFile).c_str(), L"rb") == 0 && f)
+	{
+		string utf8;
+		char chunk[4096];
+		for (size_t n; (n = fread(chunk, 1, sizeof(chunk), f)) > 0; )
+			utf8.append(chunk, n);
+		fclose(f);
+		const wstring index = string2wstring(utf8, CP_UTF8);
+		for (size_t pos = 0, end; (end = index.find(L'\n', pos)) != wstring::npos; pos = end + 1)
+		{
+			const wstring line = index.substr(pos, end - pos);
+			const size_t tab = line.find(L'\t');
+			if (tab != wstring::npos)
+				copies.emplace_back(line.substr(tab + 1), dir + L"\\" + line.substr(0, tab));
+		}
+	}
+	for (int view = 0; view < NB_VIEWS; ++view)
+	{
+		for (sessionFileInfo& sfi : session.kexViewFiles(view))
+		{
+			sfi._backupFilePath.clear();
+			for (const auto& copy : copies)
+			{
+				if (copy.first == sfi._fileName)
+					sfi._backupFilePath = copy.second;
+			}
+		}
+	}
+
+	// files opened from the command line stay last and active, as if they were opened after the copied tabs
+	vector<BufferID> commandLineFiles;
+	for (size_t i = 0; i < _mainDocTab.nbItem(); ++i)
+	{
+		BufferID id = _mainDocTab.getBufferByIndex(i);
+		Buffer* buf = MainFileManager.getBufferByID(id);
+		if (!buf->isUntitled() || buf->docLength() != 0 || buf->isDirty())
+			commandLineFiles.push_back(id);
+	}
+	const BufferID activeCommandLineFile = commandLineFiles.empty() ? BUFFER_INVALID : _mainEditView.getCurrentBufferID();
+
+	const bool isSnapshotMode = true; // so that untitled tabs load from their copies
+	loadSession(session, isSnapshotMode);
+
+	// The copies start unmodified: closing this window does not ask to save what the other one still has.
+	for (size_t i = 0; i < MainFileManager.getNbBuffers(); ++i)
+	{
+		Buffer* buf = MainFileManager.getBufferByIndex(i);
+		const wstring backup = buf->getBackupFileName();
+		if (!backup.empty() && backup.compare(0, dir.size(), dir) == 0)
+		{
+			buf->setBackupFileName(wstring());
+			buf->setDirty(false);
+		}
+	}
+
+	for (BufferID id : commandLineFiles)
+	{
+		const int index = _mainDocTab.getIndexByBuffer(id);
+		if (index < 0)
+			continue;
+		switchEditViewTo(MAIN_VIEW);
+		activateBuffer(id, MAIN_VIEW);
+		for (int moves = static_cast<int>(_mainDocTab.nbItem()) - 1 - index; moves > 0; --moves)
+			command(IDM_VIEW_TAB_MOVEFORWARD);
+	}
+	if (activeCommandLineFile != BUFFER_INVALID && _mainDocTab.getIndexByBuffer(activeCommandLineFile) >= 0)
+	{
+		switchEditViewTo(MAIN_VIEW);
+		activateBuffer(activeCommandLineFile, MAIN_VIEW);
+	}
+	return static_cast<int>(session.kexNbFiles());
+}
+
+LRESULT Notepad_plus::kexProcessMessage(UINT message, WPARAM wParam, LPARAM lParam)
+{
+	const int view = static_cast<int>(wParam);
+	const bool isValidView = (wParam < NB_VIEWS);
+
+	switch (message)
+	{
+		case NPPM_KEX_GETINFO:
+			return MAKELONG(NB_VIEWS, KEX_PATCH_VERSION);
+
+		case NPPM_KEX_GETCURRENTVIEW:
+			return currentView();
+
+		case NPPM_KEX_GETVIEWSCINTILLA:
+			return isValidView ? reinterpret_cast<LRESULT>(kexEditView(view)->getHSelf()) : 0;
+
+		case NPPM_KEX_GETVIEWTABBAR:
+			return isValidView ? reinterpret_cast<LRESULT>(kexDocTab(view)->getHSelf()) : 0;
+
+		case NPPM_KEX_ISVIEWVISIBLE:
+			return isValidView && viewVisible(view);
+
+		case NPPM_KEX_GETNBVIEWFILES:
+			return isValidView ? static_cast<LRESULT>(kexDocTab(view)->nbItem()) : 0;
+
+		case NPPM_KEX_GETVIEWBUFFERID:
+		{
+			if (!isValidView || lParam < 0 || static_cast<size_t>(lParam) >= kexDocTab(view)->nbItem())
+				return 0;
+			return reinterpret_cast<LRESULT>(kexDocTab(view)->getBufferByIndex(static_cast<size_t>(lParam)));
+		}
+
+		case NPPM_KEX_GETVIEWCURRENTINDEX:
+		{
+			if (!isValidView || kexDocTab(view)->nbItem() == 0)
+				return -1;
+			return kexDocTab(view)->getCurrentTabIndex();
+		}
+
+		case NPPM_KEX_ACTIVATEDOC:
+		{
+			if (!isValidView || !viewVisible(view) || lParam < 0 || static_cast<size_t>(lParam) >= kexDocTab(view)->nbItem())
+				return FALSE;
+			if (kexIsTornOut(view))
+				::SetForegroundWindow(_kexViewWindow[view]);
+			switchEditViewTo(view);
+			activateDoc(static_cast<size_t>(lParam));
+			return TRUE;
+		}
+
+		case NPPM_KEX_TEAROUTVIEW:
+		{
+			if (!isValidView)
+				return FALSE;
+			return lParam ? kexTearOutView(view) : kexSnapBackView(view);
+		}
+
+		case NPPM_KEX_GETVIEWHOSTWINDOW:
+		{
+			if (!isValidView)
+				return 0;
+			return reinterpret_cast<LRESULT>(kexIsTornOut(view) ? _kexViewWindow[view] : _pPublicInterface->getHSelf());
+		}
+
+		case NPPM_KEX_SAVEDESKTOPCOPY:
+			return kexSaveDesktopCopy(reinterpret_cast<const wchar_t*>(lParam));
+
+		case NPPM_KEX_LOADDESKTOPCOPY:
+			return kexLoadDesktopCopy(reinterpret_cast<const wchar_t*>(lParam));
+
+		case NPPM_KEX_ADDCOMMANDS:
+		{
+			const KexCommandList* list = reinterpret_cast<const KexCommandList*>(lParam);
+			HMENU menu = reinterpret_cast<HMENU>(wParam);
+			if (!list || !list->items || list->count <= 0 || !::IsMenu(menu))
+				return FALSE;
+			_pluginsManager.kexAddCommands(menu, *list);
+			NppParameters::getInstance().reloadPluginCmds(); // keys the user gave them in Shortcut Mapper
+			_accelerator.updateShortcuts();                  // also shows the keys in the menu
+			return TRUE;
+		}
+
+		case NPPM_KEX_ENABLECOMMAND:
+		{
+			const unsigned long id = static_cast<unsigned long>(wParam);
+			auto& keyless = _accelerator._kexKeyless;
+			const auto it = std::find(keyless.begin(), keyless.end(), id);
+			if (lParam && it != keyless.end())
+				keyless.erase(it);
+			else if (!lParam && it == keyless.end())
+				keyless.push_back(id);
+			else
+				return TRUE;
+			_accelerator.updateShortcuts();
+			return TRUE;
+		}
+
+		case NPPM_KEX_TRANSLATEACCEL:
+		{
+			MSG* msg = reinterpret_cast<MSG*>(lParam);
+			return msg && ::TranslateAccelerator(_pPublicInterface->getHSelf(), _accelerator.getAccTable(), msg) != 0;
+		}
+
+		case NPPM_KEX_SHOWSHORTCUTS:
+		{
+			ShortcutMapper shortcutMapper;
+			shortcutMapper.init(_pPublicInterface->getHinst(), _pPublicInterface->getHSelf(), STATE_PLUGIN);
+			shortcutMapper._kexFilter = L"KEX";
+			shortcutMapper.doDialog(_nativeLangSpeaker.isRTL());
+			shortcutMapper.destroy();
+			return TRUE;
+		}
+
+		case NPPM_KEX_SHOWPREFPAGE:
+			command(IDM_SETTING_KEX); // opens Preferences (on the first KEX page)
+			if (wParam > 0)
+				_preference.showDialogByName(kexsuite::prefPageName(static_cast<int>(wParam)));
+			return TRUE;
+
+		case NPPM_INTERNAL_KEX_TABDRAG:
+		{
+			kexOnTabDrag(static_cast<int>(wParam), reinterpret_cast<HWND>(lParam));
+			return TRUE;
+		}
+
+		case NPPM_INTERNAL_KEX_SPLITTERROTATED:
+		{
+			kexOnSplitterRotated(reinterpret_cast<HWND>(wParam), static_cast<int>(lParam));
+			return TRUE;
+		}
+
+		default:
+			return FALSE;
+	}
+}
+
+// The KEX suite's live token styles follow the "Style All Occurrences of Token" options of the
+// Highlighting page (KexSuiteHost.h).
+void kexsuite::styleTokenOptions(bool* matchCase, bool* wholeWord)
+{
+	const NppGUI& nppGUI = NppParameters::getInstance().getNppGUI();
+	if (matchCase)
+		*matchCase = nppGUI._markAllCaseSensitive;
+	if (wholeWord)
+		*wholeWord = nppGUI._markAllWordOnly;
+}
+
+// The KEX suite's JetBrains Alt+J selects occurrences the way Smart Highlighting highlights them,
+// unless the KEX Editing page says otherwise (KexSuiteHost.h).
+void kexsuite::smartHighlightOptions(bool* matchCase, bool* wholeWord)
+{
+	NppParameters& nppParams = NppParameters::getInstance();
+	const NppGUI& nppGUI = nppParams.getNppGUI();
+	const bool useFind = nppGUI._smartHiliteUseFindSettings;
+	if (matchCase)
+		*matchCase = useFind ? nppParams.getFindHistory()._isMatchCase : nppGUI._smartHiliteCaseSensitive;
+	if (wholeWord)
+		*wholeWord = useFind ? nppParams.getFindHistory()._isMatchWord : nppGUI._smartHiliteWordOnly;
+}
diff --git a/PowerEditor/src/MISC/PluginsManager/KexApi.h b/PowerEditor/src/MISC/PluginsManager/KexApi.h
new file mode 100644
index 0000000..71ce70f
--- /dev/null
+++ b/PowerEditor/src/MISC/PluginsManager/KexApi.h
@@ -0,0 +1,79 @@
+// KexApi.h - messages added to Notepad++ by the KEX four-view patch.
+//
+// The patch gives Notepad++ four editing views (0 = main, 1 = second, 2 = third, 3 = fourth)
+// laid out as a 2x2 grid, and lets any view be torn out into its own top-level window.
+// On an unpatched Notepad++ every message below returns 0, so a plugin calls NPPM_KEX_GETINFO
+// first and falls back to the standard two-view API when it returns 0.
+//
+// Legacy plugin messages keep their two-view meaning (NPPM_GETCURRENTVIEW etc. only ever
+// report 0 or 1), so existing plugins never see an index they don't expect.
+//
+// A plugin whose commands should also run while view 3 or 4 has focus exports
+//     extern "C" __declspec(dllexport) BOOL kexAware() { return TRUE; }
+// Without that export the patched Notepad++ blocks its menu commands in views 3/4 (with a
+// message box) and sends it Scintilla notifications from views 0/1 only.
+#pragma once
+#include <windows.h>
+
+#define KEX_USER (WM_USER + 9000)   // Notepad++ uses WM_USER+0..7999 ranges; 9000+ is free
+
+// LRESULT: MAKELONG(viewCount, patchVersion). 0 = unpatched Notepad++.
+#define NPPM_KEX_GETINFO              (KEX_USER + 1)
+// LRESULT: index (0..3) of the view that has focus.
+#define NPPM_KEX_GETCURRENTVIEW       (KEX_USER + 2)
+// wParam: view. LRESULT: that view's Scintilla HWND (NULL if view >= count).
+#define NPPM_KEX_GETVIEWSCINTILLA     (KEX_USER + 3)
+// wParam: view. LRESULT: that view's tab bar HWND.
+#define NPPM_KEX_GETVIEWTABBAR        (KEX_USER + 4)
+// wParam: view. LRESULT: TRUE if the view is shown (it has at least one tab).
+#define NPPM_KEX_ISVIEWVISIBLE        (KEX_USER + 5)
+// wParam: view. LRESULT: number of tabs open in that view.
+#define NPPM_KEX_GETNBVIEWFILES       (KEX_USER + 6)
+// wParam: view, lParam: tab index. LRESULT: BufferID (0 if out of range).
+#define NPPM_KEX_GETVIEWBUFFERID      (KEX_USER + 7)
+// wParam: view. LRESULT: index of the active tab in that view, -1 if none.
+#define NPPM_KEX_GETVIEWCURRENTINDEX  (KEX_USER + 8)
+// wParam: view, lParam: tab index. Activates that tab in that view (and focuses the view).
+#define NPPM_KEX_ACTIVATEDOC          (KEX_USER + 9)
+// wParam: view, lParam: TRUE = tear the view out into its own window, FALSE = snap it back.
+#define NPPM_KEX_TEAROUTVIEW          (KEX_USER + 10)
+// wParam: view. LRESULT: top-level HWND currently hosting the view
+// (the Notepad++ main window, or the view's own window when torn out).
+#define NPPM_KEX_GETVIEWHOSTWINDOW    (KEX_USER + 11)
+// "A Notepad++ for each desktop" (KEX suite). lParam: a folder (const wchar_t*). Writes this instance's
+// tabs there: a session file plus a copy of each untitled tab. LRESULT: tabs written, -1 on failure.
+#define NPPM_KEX_SAVEDESKTOPCOPY      (KEX_USER + 12)
+// lParam: a folder written by NPPM_KEX_SAVEDESKTOPCOPY. Opens those tabs here; files already open from
+// the command line stay last and active. LRESULT: tabs opened, -1 on failure.
+#define NPPM_KEX_LOADDESKTOPCOPY      (KEX_USER + 13)
+// wParam: a KEX Preferences page (0 "KEX Editing", 1 "KEX Tabs", 2 "KEX Windows", 3 "KEX Highlighting",
+// 4 "KEX Quick Note"). Opens Settings > Preferences on that page. LRESULT: TRUE.
+#define NPPM_KEX_SHOWPREFPAGE         (KEX_USER + 14)
+
+// Commands of the KEX features. They are added to a menu of the feature's, Settings > Shortcut Mapper
+// lists them under Plugin commands (plugin "KEX") where their keys can be changed, and their keys go
+// before Notepad++'s own, as the feature's keys did before.
+struct KexCommand {
+	int internalId;          // stable number, so Shortcut Mapper changes (shortcuts.xml) find it again
+	const wchar_t* name;
+	void (*run)();
+	bool ctrl, alt, shift;
+	unsigned char key;       // default key, 0 = none
+};
+struct KexCommandList {
+	const KexCommand* items;
+	int count;
+	int* ids;                // receives each command's menu command id
+	int position;            // where in the menu they go (-1: at the end)
+};
+// wParam: HMENU to add the commands to, lParam: KexCommandList*. LRESULT: TRUE.
+#define NPPM_KEX_ADDCOMMANDS          (KEX_USER + 15)
+// wParam: a command id from NPPM_KEX_ADDCOMMANDS, lParam: TRUE gives the command its key, FALSE takes it
+// away (while its feature is off, so the key does what it does without KEX). LRESULT: TRUE.
+#define NPPM_KEX_ENABLECOMMAND        (KEX_USER + 16)
+// Opens Settings > Shortcut Mapper on Plugin commands, showing the KEX commands. LRESULT: TRUE.
+#define NPPM_KEX_SHOWSHORTCUTS        (KEX_USER + 17)
+// lParam: MSG*. For a message loop of its own: runs Notepad++'s shortcuts (its menu commands, the
+// plugins' and KEX's) as its main loop does. LRESULT: TRUE when the message was a shortcut (then don't
+// dispatch it).
+#define NPPM_KEX_TRANSLATEACCEL       (KEX_USER + 18)
diff --git a/PowerEditor/src/MISC/PluginsManager/KexSuiteHost.h b/PowerEditor/src/MISC/PluginsManager/KexSuiteHost.h
new file mode 100644
index 0000000..a252497
--- /dev/null
+++ b/PowerEditor/src/MISC/PluginsManager/KexSuiteHost.h
@@ -0,0 +1,56 @@
+// KexSuiteHost.h - the KEX suite (falling letters, smooth caret, quick note, F12 hover tabs, tab
+// snapping, the same Notepad++ on every virtual desktop, the glass text area, live token styles) is built into notepad++.exe. Its sources
+// live in PowerEditor/src/KexSuite (kex-patch.sh copies them in from the KEX repository's suite/
+// folder). It drives Notepad++ through the documented plugin messages, so the core only hands it the
+// plugin data, every notification, the window procedure of its Preferences pages and tab drags.
+#pragma once
+
+// Settings > Preferences gets the suite's pages: dialog templates IDD_KEX_PREF_FIRST,
+// IDD_KEX_PREF_FIRST + 1, ... (KexSuite/KexSuite.rc), at most KEX_PREF_PAGES_MAX of them.
+#define IDD_KEX_PREF_FIRST 30500
+#define KEX_PREF_PAGES_MAX 8
+
+#ifndef RC_INVOKED
+#include <windows.h>
+#include "PluginInterface.h"
+
+namespace Scintilla { class ILexer5; }
+
+namespace kexsuite {
+void setInfo(HINSTANCE hInst, const NppData& data);                           // once the Scintilla views exist
+void notify(SCNotification* n);                                                // every notification, views 3 and 4 included
+intptr_t prefPageProc(HWND page, UINT message, WPARAM wParam, LPARAM lParam);   // all its Preferences pages
+int prefPageCount();                                                           // pages to add (<= KEX_PREF_PAGES_MAX)
+const wchar_t* prefPageTitle(int page);                                        // shown in the Preferences list
+const wchar_t* prefPageName(int page);                                         // internal name (showDialogByName)
+
+// Tab snapping: while a tab is dragged the core works out where it would land and the suite
+// draws the preview. tabSnapOn() false = the classic drop menu.
+bool tabSnapOn();
+void tabSnapPreview(const RECT* screenRect);                                   // nullptr hides it
+// Every step of a tab drag (KEX_TABDRAG_STARTED, _MOVED, _OVERTABS, _ENDED in TabBar.h): the suite
+// lifts the dragged tab off the bar and lets it follow the mouse.
+void tabDragged(HWND tabBar, int state);
+
+// ::WindowFromPoint for the core: the glass text area puts a click catcher behind the window, and
+// this sees through it to the view the user actually points at.
+HWND windowFromPoint(POINT screenPoint);
+
+// Live token styles: the lexer an editing view gets is wrapped, so the bold and italic given to
+// styled tokens survive every re-lex. Returns the lexer to set (the same one for other Scintillas).
+Scintilla::ILexer5* wrapLexer(Scintilla::ILexer5* lexer, HWND view);
+
+// Implemented by the core: the "Style All Occurrences of Token" options on the Highlighting page.
+void styleTokenOptions(bool* matchCase, bool* wholeWord);
+// Implemented by the core: what Smart Highlighting matches (its own options or the Find dialog's).
+void smartHighlightOptions(bool* matchCase, bool* wholeWord);
+
+// Called by a second notepad++.exe (winmain.cpp) before it hands its command line to the running one.
+// Returns the window to hand it to: one on the current virtual desktop. Returns nullptr when Notepad++ has
+// windows only on other desktops: this process then becomes a new Notepad++ for this desktop, with its
+// own session (desktopKey receives the name for its session file and backup folder, empty when the
+// desktop can't be identified). It opens with that session when the desktop had one, otherwise with a
+// copy of the other window's tabs (called before the suite is set up; settingsDir holds kex.ini).
+HWND desktopHandOff(HWND running, const wchar_t* settingsDir, wchar_t* desktopKey, int keyLen);
+}
+#endif
