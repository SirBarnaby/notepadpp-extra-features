+// KEX: Notepad++ gets four editing views laid out as a 2x2 grid:
+//
+//     MAIN_VIEW | SUB_VIEW        _subSplitter splits the two columns,
+//     ----------+----------       _kexColumnSplitter[0] splits main/view 3,
+//     VIEW_3    | VIEW_4          _kexColumnSplitter[1] splits sub/view 4.
+//
+// Any view can also be snapped out into its own top-level window ("torn out") and back in.
+// The grid is rebuilt from the visibility bits in _mainWindowStatus by kexLayoutViews().
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+#include "Notepad_plus.h"
+#include "Notepad_plus_Window.h"
+#include "NppDarkMode.h"
+#include "KexApi.h"
+#include "ShortcutMapper.h"
+
+using namespace std;
+
+static constexpr int KEX_PATCH_VERSION = 1;
+static constexpr wchar_t KEX_VIEW_WINDOW_CLASS[] = L"KexNppViewWindow";
+static constexpr int KEX_ROTATION_LEFT = 2000;  // SplitterContainer.cpp ROTATION_LEFT
+static constexpr int KEX_ROTATION_RIGHT = 2001; // SplitterContainer.cpp ROTATION_RIGHT
+
+static Notepad_plus* kexNpp = nullptr;
+static bool kexMovedSinceEnter[NB_VIEWS] = {};
+
+
+ScintillaEditView* Notepad_plus::kexEditView(int whichOne)
+{
+	switch (whichOne)
+	{
+		case MAIN_VIEW: return &_mainEditView;
+		case VIEW_3: return &_view3EditView;
+		case VIEW_4: return &_view4EditView;
+		default: return &_subEditView;
+	}
+}
+
+DocTabView* Notepad_plus::kexDocTab(int whichOne)
+{
+	switch (whichOne)
+	{
+		case MAIN_VIEW: return &_mainDocTab;
+		case VIEW_3: return &_view3DocTab;
+		case VIEW_4: return &_view4DocTab;
+		default: return &_subDocTab;
+	}
+}
+
+UCHAR Notepad_plus::kexViewBit(int whichOne)
+{
+	switch (whichOne)
+	{
+		case MAIN_VIEW: return WindowMainActive;
+		case VIEW_3: return WindowView3Active;
+		case VIEW_4: return WindowView4Active;
+		default: return WindowSubActive;
+	}
+}
+
+int Notepad_plus::kexViewOfControl(HWND hwnd)
+{
+	if (!hwnd)
+		return -1;
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		if (hwnd == kexEditView(v)->getHSelf() || hwnd == kexDocTab(v)->getHSelf())
+			return v;
+	}
+	return -1;
+}
+
+int Notepad_plus::kexViewFromHwnd(HWND hwnd)
+{
+	// walk up the parent chain: a child of a Scintilla (e.g. a call tip) or of a torn-out window counts too
+	for (int depth = 0; hwnd && depth < 8; ++depth)
+	{
+		int v = kexViewOfControl(hwnd);
+		if (v != -1)
+			return v;
+		for (int w = 0; w < NB_VIEWS; ++w)
+		{
+			if (_kexViewWindow[w] && hwnd == _kexViewWindow[w])
+				return w;
+		}
+		if (::GetWindowLongPtr(hwnd, GWL_STYLE) & WS_CHILD)
+			hwnd = ::GetParent(hwnd);
+		else
+			break;
+	}
+	return -1;
+}
+
+void Notepad_plus::kexSmartHighlight(ScintillaEditView* pView)
+{
+	// the focused view once, then every other visible view
+	ScintillaEditView* others[NB_VIEWS] = {};
+	int nb = 0;
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		ScintillaEditView* pOther = kexEditView(v);
+		if (pOther != pView && viewVisible(v))
+			others[nb++] = pOther;
+	}
+	_smartHighlighter.kexHighlightViews(pView, others, nb);
+}
+
+bool Notepad_plus::kexIsBufferInAnotherView(BufferID id, int exceptView)
+{
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		if (v != exceptView && kexDocTab(v)->getIndexByBuffer(id) != -1)
+			return true;
+	}
+	return false;
+}
+
+bool Notepad_plus::kexIsBufferInEarlierView(BufferID id, int view)
+{
+	for (int v = 0; v < view && v < NB_VIEWS; ++v)
+	{
+		if (viewVisible(v) && kexDocTab(v)->getIndexByBuffer(id) != -1)
+			return true;
+	}
+	return false;
+}
+
+BufferID Notepad_plus::kexFindBufferByNameInViews(const wchar_t* fullfilename)
+{
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		BufferID id = kexDocTab(v)->findBufferByName(fullfilename);
+		if (id != BUFFER_INVALID)
+			return id;
+	}
+	return BUFFER_INVALID;
+}
+
+int Notepad_plus::kexNextVisibleView(int fromView, bool forward)
+{
+	if (fromView < 0 || fromView >= NB_VIEWS)
+	{
+		for (int v = 0; v < NB_VIEWS; ++v)
+		{
+			if (viewVisible(v))
+				return v;
+		}
+		return MAIN_VIEW;
+	}
+
+	for (int i = 1; i <= NB_VIEWS; ++i)
+	{
+		int v = (fromView + (forward ? i : NB_VIEWS - i)) % NB_VIEWS;
+		if (viewVisible(v))
+			return v;
+	}
+	return fromView;
+}
+
+int Notepad_plus::kexNbVisibleViews() const
+{
+	int nb = 0;
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		if (_mainWindowStatus & kexViewBit(v))
+			++nb;
+	}
+	return nb;
+}
+
+AutoCompletion* Notepad_plus::kexAutoComplete(const ScintillaEditView* pView)
+{
+	if (pView == &_mainEditView)
+		return &_autoCompleteMain;
+	if (pView == &_view3EditView)
+		return &_autoCompleteView3;
+	if (pView == &_view4EditView)
+		return &_autoCompleteView4;
+	return &_autoCompleteSub;
+}
+
+int Notepad_plus::kexNbDockedViews()
+{
+	int nb = 0;
+	for (int v = 0; v < NB_VIEWS; ++v)
+	{
+		if (viewVisible(v) && !kexIsTornOut(v))
+			++nb;
+	}
+	return nb;
+}
+
