+// KEX: an older plugin's command would edit view 1 or 2 while the user is looking at view 3 or 4,
+// so it only runs from views 1 and 2.
+bool PluginsManager::kexCanRunCommand(bool isKexAware, const std::wstring& pluginName) const
+{
+	if (isKexAware || !_nppData._nppHandle)
+		return true;
+
+	LRESULT view = ::SendMessage(_nppData._nppHandle, NPPM_KEX_GETCURRENTVIEW, 0, 0);
+	if (view < 2)
+		return true;
+
+	std::wstring msg = L"\"";
+	msg += pluginName;
+	msg += L"\" was made for two views, so it can only work in view 1 or view 2.\r\rClick into view 1 or view 2 and run it again.";
+	NppDarkMode::darkMessageBoxW(_nppData._nppHandle, msg.c_str(), L"Notepad++ KEX", MB_OK | MB_ICONINFORMATION);
+	return false;
+}
