+// KEX: called in a Notepad++ started for another virtual desktop (winmain.cpp), after load() read the
+// first window's session.xml: from now on this instance reads and writes session-<key>.xml and keeps
+// its backups in backup\<key>\. Returns false for an unusable key (the caller then runs without session).
+bool NppParameters::kexUseDesktopSession(const std::wstring& key)
+{
+	// "desktop-" and the desktop's id: hex digits and dashes
+	if (key.size() < 9 || key.size() > 60 || key.compare(0, 8, L"desktop-") != 0 || key.find_first_not_of(L"ABCDEFabcdef0123456789-", 8) != std::wstring::npos)
+		return false;
+	_kexDesktopKey = key;
+	_sessionPath = _userPath;
+	pathAppend(_sessionPath, L"session-" + key + L".xml");
+	_session = Session();
+	if (_nppGUI._rememberLastSession && doesFileExist(_sessionPath.c_str()))
+		loadSession(_session, _sessionPath.c_str(), true);
+	return true;
+}
