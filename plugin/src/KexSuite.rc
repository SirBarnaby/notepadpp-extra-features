// KexSuite.rc - Options dialog and version info
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_OPTIONS DIALOGEX 0, 0, 340, 322
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KEX Suite Options"
FONT 8, "MS Shell Dlg", 400, 0, 1
BEGIN
    GROUPBOX        "Falling letters (CS2D style)", -1, 7, 4, 326, 62
    AUTOCHECKBOX    "Enabled", IDC_L_EN, 14, 16, 50, 10
    LTEXT           "", IDC_L_STATUS, 70, 17, 258, 9
    LTEXT           "Gravity (px/s\xB2):", -1, 14, 33, 58, 8
    EDITTEXT        IDC_L_GRAVITY, 74, 31, 34, 12, ES_NUMBER
    LTEXT           "Max letters:", -1, 118, 33, 42, 8
    EDITTEXT        IDC_L_MAX, 160, 31, 28, 12, ES_NUMBER
    LTEXT           "Spin (\xB0/s):", -1, 198, 33, 38, 8
    EDITTEXT        IDC_L_SPIN, 238, 31, 28, 12, ES_NUMBER
    LTEXT           "Drift (px/s):", -1, 14, 49, 58, 8
    EDITTEXT        IDC_L_DRIFT, 74, 47, 34, 12, ES_NUMBER
    AUTOCHECKBOX    "Respect Windows ""animation effects off""", IDC_L_RESPECT, 118, 48, 140, 10
    AUTOCHECKBOX    "Undo/redo too", IDC_L_UNDO, 262, 48, 66, 10

    GROUPBOX        "Smooth caret", -1, 7, 70, 326, 46
    AUTOCHECKBOX    "Enabled", IDC_C_EN, 14, 82, 50, 10
    LTEXT           "", IDC_C_STATUS, 70, 83, 258, 9
    LTEXT           "Glide (ms):", -1, 14, 99, 40, 8
    EDITTEXT        IDC_C_GLIDE, 56, 97, 28, 12, ES_NUMBER
    LTEXT           "Snap after (lines):", -1, 92, 99, 62, 8
    EDITTEXT        IDC_C_SNAP, 156, 97, 26, 12, ES_NUMBER
    AUTOCHECKBOX    "Fade blink", IDC_C_FADE, 190, 98, 50, 10
    AUTOCHECKBOX    "Block caret in overtype", IDC_C_OVB, 244, 98, 86, 10

    GROUPBOX        "Quick note (global hotkey)", -1, 7, 120, 326, 62
    AUTOCHECKBOX    "Enabled", IDC_H_EN, 14, 132, 50, 10
    LTEXT           "", IDC_H_STATUS, 70, 133, 258, 9
    LTEXT           "Hotkey:", -1, 14, 149, 28, 8
    CONTROL         "", IDC_H_KEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 44, 147, 84, 12
    AUTOCHECKBOX    "+ Win", IDC_H_WIN, 134, 148, 34, 10
    LTEXT           "", IDC_H_KEYSTATUS, 172, 149, 156, 9
    AUTOCHECKBOX    "Keep the text between uses", IDC_H_POSTIT, 14, 165, 110, 10
    AUTOCHECKBOX    "Fade in and out", IDC_H_SLIDE, 134, 165, 80, 10

    GROUPBOX        "F12 hover tabs", -1, 7, 186, 326, 46
    AUTOCHECKBOX    "Enabled", IDC_T_EN, 14, 198, 50, 10
    LTEXT           "", IDC_T_STATUS, 70, 199, 258, 9
    LTEXT           "Hot zone (px):", -1, 14, 215, 50, 8
    EDITTEXT        IDC_T_ZONE, 66, 213, 26, 12, ES_NUMBER
    LTEXT           "Hide delay (ms):", -1, 104, 215, 56, 8
    EDITTEXT        IDC_T_DELAY, 162, 213, 30, 12, ES_NUMBER

    GROUPBOX        "Same Notepad++ on every desktop", -1, 7, 236, 326, 58
    AUTOCHECKBOX    "Enabled", IDC_D_EN, 14, 248, 50, 10
    LTEXT           "", IDC_D_STATUS, 70, 249, 258, 9
    LTEXT           "Poll every (ms):", -1, 14, 265, 54, 8
    EDITTEXT        IDC_D_POLL, 70, 263, 30, 12, ES_NUMBER
    AUTOCHECKBOX    "Title-bar X closes only on this desktop (when on 2+ desktops)", IDC_D_CLOSE, 110, 264, 218, 10
    LTEXT           "", IDC_D_INFO, 14, 280, 314, 9

    LTEXT           "", IDC_SUMMARY, 7, 304, 150, 9
    DEFPUSHBUTTON   "OK", IDOK, 175, 300, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 229, 300, 50, 14
    PUSHBUTTON      "Apply", IDC_APPLY, 283, 300, 50, 14
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KEX Suite plugin for Notepad++"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "KexSuite"
            VALUE "OriginalFilename", "KexSuite.dll"
            VALUE "ProductName", "KEX Suite"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
